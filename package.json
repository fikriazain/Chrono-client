{
  "name": "chrono-client",
  "productName": "Chrono Receiver",
  "version": "1.0.7",
  "description": "Chrono message receiver",
  "author": "Zain",
  "license": "ISC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zain.chronoreceiver",
    "productName": "Chrono Receiver",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "bubble.js",
      "fx.js",
      "index.html",
      "bubble.html",
      "fx.html",
      "setup.html",
      "assets/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fikriazain",
        "repo": "chrono-client",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Chrono Receiver.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
